# 模板文件：运行 scripts/install-desktop.sh 生成桌面快捷方式（自动填入项目绝对路径）
[Desktop Entry]
Version=1.0
Type=Application
Name=IO Gateway
Name[zh_CN]=IO Gesture
Comment=外骨骼手套 · 灵巧手操控平台
Exec=@IO_ROOT@/scripts/run_gateway.sh
Path=@IO_ROOT@
Icon=@IO_ROOT@/configs/IO.png
Terminal=true
Categories=Development;Utility;
StartupNotify=true
