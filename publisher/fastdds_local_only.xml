<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local-only ROS profile (used by tianyee full-stack).

  Arm control uses the UDP bridge, so local publishers do not need DDS access
  to the robot.  Disable builtin transports and expose only loopback UDP plus
  shared memory.  ROS_DOMAIN_ID (default 42) is set separately by run_full_stack.sh.
-->
<dds>
  <profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>local_loopback_udp</transport_id>
        <type>UDPv4</type>
        <interfaceWhiteList>
          <address>127.0.0.1</address>
        </interfaceWhiteList>
        <maxInitialPeersRange>10</maxInitialPeersRange>
        <maxMessageSize>65500</maxMessageSize>
        <sendBufferSize>1048576</sendBufferSize>
        <receiveBufferSize>1048576</receiveBufferSize>
      </transport_descriptor>
      <transport_descriptor>
        <transport_id>local_image_shm</transport_id>
        <type>SHM</type>
        <segment_size>16777216</segment_size>
        <port_queue_capacity>1024</port_queue_capacity>
      </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="local_only_participant" is_default_profile="true">
      <rtps>
        <useBuiltinTransports>false</useBuiltinTransports>
        <userTransports>
          <transport_id>local_loopback_udp</transport_id>
          <transport_id>local_image_shm</transport_id>
        </userTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
